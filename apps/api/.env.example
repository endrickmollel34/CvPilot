# ─── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────
# Local: postgresql://cvpilot:cvpilot@localhost:5432/cvpilot
# Neon: postgresql://<user>:<pass>@<host>/cvpilot?sslmode=require
DATABASE_URL=

# ─── Redis ───────────────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Upstash: rediss://<token>@<host>:6380
REDIS_URL=

# ─── Clerk ───────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ─── OpenAI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Anthropic (fallback) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from Stripe dashboard
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_STUDENT_MONTHLY=

# ─── Cloudflare R2 ───────────────────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# R2 endpoint: https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=

# ─── Resend ──────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@cvpilot.app

# ─── Sentry ──────────────────────────────────────────────────────────────
SENTRY_DSN=

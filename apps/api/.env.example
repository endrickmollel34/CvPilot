# ─── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────
# Local: postgresql://cvpilot:cvpilot@localhost:5432/cvpilot
# Neon: postgresql://<user>:<pass>@<host>/cvpilot?sslmode=require
DATABASE_URL=

# ─── Redis ───────────────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Upstash: rediss://<token>@<host>:6380
REDIS_URL=

# ─── Clerk ───────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ─── OpenAI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Anthropic (fallback) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from Stripe dashboard — see the pricing restructure report for
# exactly what to create for each of these (one-time vs recurring, amount,
# interval). All required except the legacy one below.
# One-time €2.99 introductory charge — first invoice only, paired with the
# recurring monthly price via subscription_data.trial_period_days: 7.
STRIPE_PRICE_PRO_MONTHLY_INTRO=
# Recurring €14.99/month price — its first charge is deferred 7 days by the
# checkout session's trial_period_days, not by anything on this Price itself.
STRIPE_PRICE_PRO_MONTHLY=
# Recurring €79.99/year price.
STRIPE_PRICE_PRO_ANNUAL=
# Legacy — Student is no longer offered for new checkout (see
# CreateCheckoutDto), but an existing Student subscriber's webhook events
# still need this to resolve to the Pro entitlement rather than silently
# falling back to Free. Genuinely optional: leave unset in any environment
# that never had a Student plan configured.
STRIPE_PRICE_STUDENT_MONTHLY=

# ─── Cloudflare R2 ───────────────────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# R2 endpoint: https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=

# ─── Resend ──────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@cvpilot.app
# Private destination inbox for /contact form submissions — never exposed to
# the frontend/client bundle. Server-only; do not prefix with NEXT_PUBLIC_.
CONTACT_RECIPIENT_EMAIL=placeholder@example.com

# ─── Sentry ──────────────────────────────────────────────────────────────
SENTRY_DSN=
